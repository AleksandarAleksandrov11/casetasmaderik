{
  "name": "casetas-maderik",
  "version": "1.0.0",
  "private": true,
  "description": "Web de Casetas Maderik: alquiler de casetas de madera para ferias, mercados y eventos.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test --config tests/playwright.config.ts",
    "qa:screens": "playwright test --config tests/qa/playwright.qa.config.ts",
    "qa:lighthouse": "lhci autorun --config=tests/qa/lighthouserc.cjs",
    "qa:links": "node tests/qa/links.mjs",
    "qa": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm e2e && pnpm qa:screens && pnpm qa:links && pnpm qa:lighthouse"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "6.0.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lucide-react": "1.60.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "postprocessing": "6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "three": "0.186.1",
    "vanilla-cookieconsent": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/outfit": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "linkinator": "8.1.0",
    "opentype.js": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "schema-dts": "2.1.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
